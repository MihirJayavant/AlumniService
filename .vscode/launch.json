{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Alumni.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Source/Apps/Alumni.Api/bin/Debug/net10.0/Alumni.Api.dll",
      "cwd": "${workspaceFolder}/Source/Apps/Alumni.Api",
      "launchSettingsProfile": "Alumni.Api",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "ProxyApp",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Source/Apps/ProxyApp/bin/Debug/net10.0/ProxyApp.dll",
      "cwd": "${workspaceFolder}/Source/Apps/ProxyApp",
      "launchSettingsProfile": "ProxyApp",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Attach to .NET process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
